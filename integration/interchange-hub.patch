+describe("Anthropic adapter — direct browser access", () => {
+  test("omits the browser access header by default", () => {
+    const request = createAnthropicAdapter(TEST_SOURCE).buildRequest(
+      [],
+      "claude",
+      {},
+    );
+    expect(request.headers).not.toHaveProperty(
+      "anthropic-dangerous-direct-browser-access",
+    );
+  });
+
+  test("adds the browser access header when explicitly configured", () => {
+    const request = createAnthropicAdapter(TEST_SOURCE, {
+      directBrowserAccess: true,
+    }).buildRequest([], "claude", {});
+    expect(request.headers["anthropic-dangerous-direct-browser-access"]).toBe(
+      "true",
+    );
+  });
+});
