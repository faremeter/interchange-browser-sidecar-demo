{
  "id": "browser-bundled-workflow",
  "triggers": [
    {
      "type": "manual"
    }
  ],
  "steps": {
    "fact_check": {
      "kind": "onTrigger",
      "id": "fact_check",
      "on": {
        "type": "manual"
      },
      "body": {
        "inline": {
          "id": "browser-bundled-workflow__fact_check",
          "triggers": [
            {
              "type": "manual"
            }
          ],
          "steps": {
            "agent": {
              "kind": "step",
              "id": "agent",
              "agent": {
                "id": "browser-bundled-agent",
                "systemPrompt": "Always call browser_info first. Then assess the user's claim from model knowledge. Clearly label it true, false, misleading, or unverifiable and give a concise explanation. Say that browser execution was verified, but do not claim you browsed or checked external sources.",
                "toolFactories": [],
                "capabilities": [],
                "inference": {
                  "sources": [
                    {
                      "provider": "anthropic",
                      "model": "claude-haiku-4-5-20251001"
                    }
                  ]
                }
              },
              "drainBehavior": "cancel",
              "input": {
                "from": "trigger.payload"
              }
            }
          },
          "stepOrder": [
            "agent"
          ]
        }
      },
      "drainBehavior": "wait"
    }
  },
  "stepOrder": [
    "fact_check"
  ]
}
